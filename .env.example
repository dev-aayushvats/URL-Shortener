# Copy to .env for local development (docker compose sets these itself for the api container).
BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/url_shortener
REDIS_URL=redis://localhost:6379/0

# Optional (defaults shown)
# CACHE_ENABLED=true
# CACHE_TTL_SECONDS=86400
# SHORT_CODE_LENGTH=8
# RATE_LIMIT_PER_MINUTE=10
# MIN_EXPIRY_SECONDS=60
# MAX_EXPIRY_SECONDS=31536000
# LOG_LEVEL=INFO
# LOG_FORMAT=json
